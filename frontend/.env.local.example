NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Error tracking (optional — https://sentry.io, free tier) ─────────────────
# Stays fully disabled until this is set. Create a project (Platform: Next.js),
# copy its DSN here. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN (set in your
# deploy environment, not committed here) additionally enable source map
# upload at build time — optional, error capture works without them.
NEXT_PUBLIC_SENTRY_DSN=
