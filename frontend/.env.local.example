NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Error tracking (optional — https://sentry.io, free tier) ─────────────────
# Stays fully disabled until this is set. Create a project (Platform: Next.js),
# copy its DSN here. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN (set in your
# deploy environment, not committed here) additionally enable source map
# upload at build time — optional, error capture works without them.
NEXT_PUBLIC_SENTRY_DSN=

# ── Google Sign-In (optional) ─────────────────────────────────────────────────
# Stays fully disabled (no button rendered) until this is set. Create an OAuth
# client (Web application type) in Google Cloud Console; the client secret is
# never needed here — it lives only in the backend's own env, unused by the
# ID-token flow this app uses.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
