# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5434/aegis

# ── Groq (AI) ─────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── OpenRouter (AI fallback — https://openrouter.ai) ─────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ── Gemini (free tier — fast first attempt for portfolio review/ask only) ────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
AI_TIMEOUT_SECONDS=60

# Optional: NewsAPI for richer headlines (falls back to free RSS if absent)
NEWS_API_KEY=

# ── Error tracking (optional — https://sentry.io, free tier) ─────────────────
# Stays fully disabled until this is set. Create a project (Platform: FastAPI),
# copy its DSN here.
SENTRY_DSN=
